{
  "name": "storybook-amp",
  "version": "4.0.0",
  "description": "Storybook addon for AMP Html. Allows to display in your stories AMP Html components generated with React.",
  "author": {
    "name": "Arthelokyo",
    "email": "hello@arthelokyo.com",
    "url": "https://github.com/arthelokyo"
  },
  "license": "MIT",
  "keywords": [
    "storybook-addon",
    "storybook-addons",
    "code",
    "amp",
    "amp-html",
    "amphtml",
    "react",
    "storybook",
    "addon",
    "test",
    "storybook amp"
  ],
  "homepage": "https://storybook.js.org/addons/storybook-amp",
  "bugs": {
    "url": "https://github.com/arthelokyo/storybook-amp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arthelokyo/storybook-amp.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./manager": "./dist/manager.js",
    "./preview": "./dist/preview.js",
    "./render-fn/styled-components": "./dist/render-fn/styled-components.js",
    "./render-fn/emotion-js": "./dist/render-fn/emotion-js.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "clean": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run build",
    "storybook": "npm --prefix example run storybook",
    "build-storybook": "npm --prefix example run build-storybook"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "storybook": "^10.0.0 || ^11.0.0-0"
  },
  "peerDependenciesMeta": {
    "@emotion/cache": {
      "optional": true
    },
    "@emotion/react": {
      "optional": true
    },
    "@emotion/server": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    }
  },
  "bundler": {
    "managerEntries": [
      "src/manager.jsx"
    ],
    "previewEntries": [
      "src/index.js",
      "src/preview.js",
      "src/render-fn/styled-components.js",
      "src/render-fn/emotion-js.jsx"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "storybook": {
    "displayName": "Storybook AMP Html",
    "unsupportedFrameworks": [],
    "supportedFrameworks": [
      "react"
    ],
    "icon": "https://raw.githubusercontent.com/arthelokyo/storybook-amp/main/amp-logo.png"
  }
}
